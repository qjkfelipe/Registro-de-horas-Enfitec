# Garante que o cabeçalho Authorization chegue ao PHP em CGI/FastCGI/FPM (4.14).
<IfModule mod_cgi.c>
    CGIPassAuth On
</IfModule>

# Roteia todas as requisições para index.php (exceto arquivos/pastas reais).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Preserva o Authorization (alternativa universal ao CGIPassAuth) — 4.14.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Protege arquivos sensíveis (config, banco, schema, docs e arquivos ocultos).
<FilesMatch "(^config\.php$|\.db$|\.sqlite$|^schema\.sql$|\.md$|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloqueia acesso web direto a QUALQUER .php (scripts de admin como seed.php,
# migrar.php e importar_membros.php não devem ser executáveis pela URL).
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Exceção: o front controller é o único ponto de entrada permitido.
# O rewrite acima reescreve as rotas para ele internamente.
<FilesMatch "^index\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
